# Postgres connection string (Neon, Supabase, or any Postgres). Required --
# clients, moderation history, and the blocklist are all stored here now,
# not in local files (which don't survive on serverless hosts like Vercel).
# From Neon: dashboard > your project > Connection string.
DATABASE_URL=

# Required. Signs the login cookie clients get after /signup or /login
# (app/api/signup, app/api/login). Any long random string -- generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this logs every client out (their existing cookies stop verifying).
SESSION_SECRET=

# Arbitrary string you choose; must match what you enter in the Meta
# App Dashboard > Webhooks > Page subscription screen. Shared across
# every client, since they're all subscribed through this one Meta app.
FB_VERIFY_TOKEN=

# Meta App ID + secret (App Dashboard > Settings > Basic). The secret
# verifies the X-Hub-Signature-256 header on incoming webhook POSTs. Both
# are also used for the client-facing "Connect Facebook" OAuth button
# (Settings page > lib/facebookAuth.js > app/api/oauth/facebook/callback),
# which exchanges a Login dialog code for a Page access token instead of
# walking the client through Graph API Explorer by hand.
#
# For that button to work, add this exact URL to App Dashboard > Facebook
# Login > Settings > Valid OAuth Redirect URIs, for every domain the app
# is served on (prod + any preview URLs):
#   https://<your-domain>/api/oauth/facebook/callback
#
# Leave FB_APP_ID unset to fall back to manual Page ID/token paste only.
FB_APP_ID=
FB_APP_SECRET=

# App ID + App Secret for the separate "Instagram API with Instagram
# Login" product (App Dashboard > Use cases > Instagram API setup --
# it has its own App ID/Secret, distinct from FB_APP_SECRET above).
# Instagram comment webhooks enabled via that product's own "Abonnement
# Webhooks" toggle are signed with IG_APP_SECRET, not FB_APP_SECRET.
#
# Both are also used for the client-facing "Connect Instagram" OAuth
# button (Settings page > lib/instagramAuth.js > app/api/oauth/instagram/callback).
# For that button to work, add this exact URL to App Dashboard > Instagram
# > API setup with Instagram login > Business login settings > Valid OAuth
# Redirect URIs, for every domain the app is served on (prod + any preview URLs):
#   https://<your-domain>/api/oauth/instagram/callback
#
# Leave both unset if no client's Instagram is wired up yet -- the
# "Connect Instagram" button hides itself when IG_APP_ID is unset, falling
# back to manual token paste in Settings.
IG_APP_ID=
IG_APP_SECRET=

# Graph API version to target. Match this to whatever version your App
# Dashboard's Webhooks fields show as selected (check there if unsure) --
# using a much older version than the app is actually configured for has
# caused mismatched behavior for us before.
GRAPH_API_VERSION=v26.0

# Set to "true" to log the raw JSON of every incoming webhook payload --
# useful when confirming a field's real shape (Meta's docs don't always
# match what's actually sent). Leave unset/false in normal operation.
DEBUG_WEBHOOK_PAYLOAD=

# OpenAI. One shared key -- moderation cost across every client's
# comments is billed to this key, not split per client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Your credentials for the super-admin screen (/admin) -- add/pause/delete
# any client. Also work as a fallback login on any individual client's
# dashboard (/clients/:id/dashboard), for support access without needing
# that client's own password. Clients log into their own dashboard with
# the email/password they set at /signup instead -- this pair is yours
# alone, not shared with them. /admin returns 401/503 until both are set.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Per-client Page/IG IDs and access tokens are NOT set here anymore --
# either a client adds themselves at /signup, or you add them manually
# through /admin. Either way they land in the clients table in
# DATABASE_URL. See README for the Graph API Explorer steps to generate
# a client's tokens.
